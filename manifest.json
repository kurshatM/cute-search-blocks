{
  "manifest_version": 3,
  "name": "Cute Search Blocks",
  "version": "1.1.0",
  "description": "Transforms Google Search results into a cute, interactive grid of visual blocks with category icons.",
  "permissions": [],
  "browser_specific_settings": {
    "gecko": {
      "id": "cute-search-blocks@extension",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.co.in/search*",
        "*://www.google.co.jp/search*",
        "*://www.google.co.kr/search*",
        "*://www.google.co.id/search*",
        "*://www.google.co.th/search*",
        "*://www.google.co.za/search*",
        "*://www.google.ca/search*",
        "*://www.google.de/search*",
        "*://www.google.fr/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
        "*://www.google.com.br/search*",
        "*://www.google.com.au/search*",
        "*://www.google.com.tr/search*",
        "*://www.google.com.mx/search*",
        "*://www.google.nl/search*",
        "*://www.google.pl/search*",
        "*://www.google.se/search*",
        "*://www.google.ru/search*"
      ],
      "js": [
        "categories.js",
        "icons.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
